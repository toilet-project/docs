[Unit]
Description=Verify newest metadata backup in isolated MySQL and promote verified hash
After=docker.service
Requires=docker.service
OnFailure=geupddong-restore-failure.service

[Service]
Type=oneshot
User=luha
UMask=0077
ExecStart=/usr/bin/python3 /home/luha/.local/bin/verify-and-refresh-backup.py
TimeoutStartSec=30min
TimeoutStopSec=150s
KillMode=mixed
Nice=10
# Docker child is independently limited to 1 CPU/1 GiB and has no network/host ports.
# Do not use PrivateTmp: Docker cleanup review needs the real /tmp run directory.
