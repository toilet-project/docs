[Unit]
Description=Notify Discord when encrypted MySQL backup fails
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=luha
UMask=0077
StateDirectory=geupddong-backup-failure
StateDirectoryMode=0700
Environment=GEUPDDONG_SYSTEMD_FAILURE_ENABLED=true
Environment=GEUPDDONG_FAILURE_EXPECTED_UNIT=geupddong-mysql-backup.service
Environment=GEUPDDONG_FAILURE_STATE_DIR=/var/lib/geupddong-backup-failure
Environment=GEUPDDONG_FAILURE_WEBHOOK_FILE=/home/luha/toilet-batch/.env
ExecStart=/usr/bin/python3 /home/luha/.local/bin/systemd-retention-failure.py
TimeoutStartSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
