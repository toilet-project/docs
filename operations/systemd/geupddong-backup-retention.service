[Unit]
Description=Geupddong backup retention inspection (read-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=luha
UMask=0077
EnvironmentFile=/home/luha/.config/geupddong/backup-retention.env
ExecStart=/home/luha/.local/bin/mysql-backup-retention.sh --dry-run
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/luha/backups/geupddong/mysql /home/luha/.local/state/geupddong-backup-retention

# Exit 2 means expired/blocked items need attention. Do not hide it as a successful check.
